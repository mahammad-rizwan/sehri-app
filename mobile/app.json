{
  "expo": {
    "name": "One Message",
    "slug": "sehri-connect",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "sehriconnect",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0D1B2A"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.sehriconnect.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "We use your location for live delivery tracking, and to centre the map when an admin places a delivery point.",
        "NSLocationAlwaysUsageDescription": "We use your location for live delivery tracking.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "We share your location with users only while you are delivering, so they can follow your Sehri delivery live.",
        "UIBackgroundModes": [
          "location"
        ],
        "ITSAppUsesNonExemptEncryption": false
      },
      "config": {
        "googleMapsApiKey": "AIzaSyB201CdFWUMuuiS80yN25C6L1UmuOti7ZA"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0D1B2A"
      },
      "package": "com.sehriconnect.app",
      "softwareKeyboardLayoutMode": "pan",
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyABE2j8NsYAARwOlz5gi2yvRqqtShjEG1c"
        }
      },
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_LOCATION",
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE",
        "WAKE_LOCK",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "READ_MEDIA_IMAGES",
        "READ_MEDIA_VIDEO"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/IndopakNastaleeq.ttf"
          ]
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#C9A84C",
          "sounds": [
            "./assets/sounds/sehri_alert.wav"
          ]
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "googleServicesFile": "./google-services.json",
            "usesCleartextTraffic": false,
            "compileSdkVersion": 34,
            "targetSdkVersion": 34,
            "buildToolsVersion": "34.0.0"
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Sehri Connect to access your photos to upload donation payment proof.",
          "cameraPermission": false
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Allow Sehri Connect to save the donation QR code to your device.",
          "savePhotosPermission": "Allow Sehri Connect to save the donation QR code to your device.",
          "isAccessMediaLocationEnabled": true
        }
      ],
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "07ed36cc-e75c-47bb-afb0-0b464d4bd275"
      }
    },
    "owner": "rizwan866",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/07ed36cc-e75c-47bb-afb0-0b464d4bd275"
    }
  }
}
