{
  "expo": {
    "name": "Sehri Connect",
    "slug": "sehri-connect",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "sehriconnect",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0D1B2A"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.sehriconnect.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "We use your location for live delivery tracking.",
        "NSLocationAlwaysUsageDescription": "We use your location for live delivery tracking."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0D1B2A"
      },
      "package": "com.sehriconnect.app",
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyAWQfQB0HfybB3h-yflpD1Dws6EuhY-8go"
        }
      },
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-font",
        {
          "fonts": ["./assets/fonts/IndopakNastaleeq.ttf"]
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#C9A84C"
        }
      ],
      [
        "react-native-maps",
        {
          "googleMapsApiKey": "AIzaSyAWQfQB0HfybB3h-yflpD1Dws6EuhY-8go"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
