{
  "private": true,
  "name": "sehri-connect",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "node scripts/start-dev.js",
    "start:offline": "expo start --offline --clear",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "build:preview": "eas build --platform android --profile preview",
    "build:debug": "eas build --platform android --profile debug-apk",
    "build:prod": "eas build --platform android --profile production",
    "emulator:start": "powershell -ExecutionPolicy Bypass -File ./emulator-helper.ps1 start",
    "emulator:fix": "powershell -ExecutionPolicy Bypass -File ./emulator-helper.ps1 fix",
    "emulator:status": "powershell -ExecutionPolicy Bypass -File ./emulator-helper.ps1 status",
    "start:tunnel": "node scripts/start-dev.js --tunnel",
    "start:lan": "node scripts/start-dev.js",
    "start:clear": "node scripts/start-dev.js --clear",
    "build:dev": "eas build --profile development --platform android",
    "start:plain": "expo start"
  },
  "dependencies": {
    "@expo/vector-icons": "15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "axios": "^1.7.9",
    "expo": "~54.0.17",
    "expo-application": "~7.0.8",
    "expo-asset": "~12.0.13",
    "expo-build-properties": "~1.0.10",
    "expo-clipboard": "~8.0.8",
    "expo-constants": "~18.0.13",
    "expo-device": "~8.0.10",
    "expo-file-system": "~19.0.24",
    "expo-font": "~14.0.12",
    "expo-image-picker": "~17.0.11",
    "expo-linear-gradient": "~15.0.8",
    "expo-linking": "~8.0.12",
    "expo-location": "~19.0.8",
    "expo-media-library": "~18.2.1",
    "expo-notifications": "~0.32.17",
    "expo-router": "~6.0.24",
    "expo-secure-store": "~15.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-task-manager": "~14.0.9",
    "expo-updates": "~29.0.18",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-maps": "1.20.1",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-toast-message": "^2.2.1",
    "react-native-worklets": "0.5.1",
    "socket.io-client": "^4.8.3",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "@expo/ngrok": "^4.1.3",
    "@types/react": "~19.1.0",
    "typescript": "^5.7.3"
  }
}
