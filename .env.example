# ─── Server ────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# ─── Database (MySQL) ──────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_NAME=sehri_connect
DB_USER=root
DB_PASSWORD=

# ─── JWT ───────────────────────────────────────────────────────────────────
JWT_SECRET=
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=30d

# ─── OTP — MessageCentral VerifyNow ────────────────────────────────────────
# Primary credentials
MESSAGECENTRAL_CUSTOMER_ID=
MESSAGECENTRAL_PASSWORD=
# Optional backup credentials, tried automatically if the primary pair fails
MESSAGECENTRAL_CUSTOMER_ID1=
MESSAGECENTRAL_PASSWORD1=

# ─── Donation proof storage ────────────────────────────────────────────────
# Railway's disk is ephemeral — without these, uploaded proofs are lost on
# every redeploy. Set either CLOUDINARY_URL, or the three separate values.
CLOUDINARY_URL=
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# ─── CORS / Socket.IO origin in production ─────────────────────────────────
FRONTEND_URL=

# ─── Super Admin (read by `npm run seed`; no defaults, seeding fails without) ─
SUPER_ADMIN_PHONE=
SUPER_ADMIN_NAME=
SUPER_ADMIN_PASSWORD=

# ─── Test fixtures (optional, dev only — see src/database/seed-test-users.js) ─
# TEST_USER_PASSWORD=
# TEST_ADMIN_PASSWORD=
